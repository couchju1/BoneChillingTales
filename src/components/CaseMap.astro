---
// Home page "Cases by state" map. Every state is a square on a grid shaped like the
// country, shaded by how many stories it has. Picking a state shows its cases beside the map.
// Without JavaScript the squares are plain links to each state's page.
import StatusChip from "./StatusChip.astro";
import CasePhoto from "./CasePhoto.astro";
import { site } from "../lib/config";
import { STATE_NAMES, type Case } from "../lib/content";

interface Props {
  cases: Case[];
}

const { cases } = Astro.props;

// Column and row for each state, so the grid reads as a map of the US.
const GRID: Record<string, [number, number]> = {
  AK: [0, 0], ME: [10, 0],
  WI: [5, 1], VT: [9, 1], NH: [10, 1],
  WA: [0, 2], ID: [1, 2], MT: [2, 2], ND: [3, 2], MN: [4, 2], IL: [5, 2], MI: [6, 2], NY: [8, 2], MA: [9, 2],
  OR: [0, 3], NV: [1, 3], WY: [2, 3], SD: [3, 3], IA: [4, 3], IN: [5, 3], OH: [6, 3], PA: [7, 3], NJ: [8, 3], CT: [9, 3], RI: [10, 3],
  CA: [0, 4], UT: [1, 4], CO: [2, 4], NE: [3, 4], MO: [4, 4], KY: [5, 4], WV: [6, 4], VA: [7, 4], MD: [8, 4], DE: [9, 4],
  AZ: [1, 5], NM: [2, 5], KS: [3, 5], AR: [4, 5], TN: [5, 5], NC: [6, 5], SC: [7, 5], DC: [8, 5],
  OK: [3, 6], LA: [4, 6], MS: [5, 6], AL: [6, 6], GA: [7, 6],
  HI: [0, 7], TX: [3, 7], FL: [8, 7],
};

const PANEL_LIMIT = 4;

const byState = new Map<string, Case[]>();
for (const c of cases) byState.set(c.data.state, [...(byState.get(c.data.state) ?? []), c]);
for (const list of byState.values()) list.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const count = (code: string) => byState.get(code)?.length ?? 0;
const shade = (n: number) => (n >= 5 ? 3 : n >= 2 ? 2 : 1);
const cases_ = (n: number) => (n === 1 ? "1 case" : `${n} cases`);

// The map opens on the state with the most stories. Ties go to the launch states' order.
const active = [...site.launchStates, ...byState.keys()].reduce((best, code) => (count(code) > count(best) ? code : best));

const tiles = Object.entries(GRID).map(([code, [col, row]]) => {
  const n = count(code);
  const kind = n > 0 ? "has" : site.launchStates.includes(code) ? "soon" : "none";
  return { code, col, row, n, kind, name: STATE_NAMES[code] ?? code };
});

const panels = tiles.filter((t) => t.kind !== "none");

/** "3 unsolved, 2 missing and 2 solved" from a state's cases. */
function breakdown(list: Case[]): string {
  const tally = new Map<string, number>();
  for (const c of list) {
    const label = c.data.status === "unresolved" ? "with open questions" : site.statuses[c.data.status].label.toLowerCase();
    tally.set(label, (tally.get(label) ?? 0) + 1);
  }
  const parts = [...tally].sort((a, b) => b[1] - a[1]).map(([label, n]) => `${n} ${label}`);
  return parts.length > 1 ? `${parts.slice(0, -1).join(", ")} and ${parts.at(-1)}` : (parts[0] ?? "");
}
---

<div class="case-map" data-case-map>
  <div class="grid" role="group" aria-label="Pick a state">
    {
      tiles.map((t) =>
        t.kind === "none" ? (
          <span class="tile none" style={`--c:${t.col + 1};--r:${t.row + 1}`} aria-hidden="true">
            <span class="abbr">{t.code}</span>
          </span>
        ) : (
          <a
            class:list={["tile", t.kind, t.kind === "has" && `s${shade(t.n)}`]}
            style={`--c:${t.col + 1};--r:${t.row + 1}`}
            href={t.kind === "has" ? `/states/${t.code.toLowerCase()}/` : "/suggest/"}
            aria-label={`${t.name}: ${t.kind === "has" ? cases_(t.n) : "coming soon"}`}
            aria-current={t.code === active ? "true" : undefined}
            data-state={t.code}
          >
            <span class="abbr" aria-hidden="true">{t.code}</span>
            {t.n > 0 && <span class="n ui" aria-hidden="true">{t.n}</span>}
          </a>
        ),
      )
    }
  </div>

  <div class="panels" aria-live="polite">
    {
      panels.map((t) => {
        const list = byState.get(t.code) ?? [];
        return (
          <section class="panel" data-panel={t.code} hidden={t.code !== active} aria-labelledby={`map-${t.code}`}>
            <h3 id={`map-${t.code}`}>{t.name}</h3>
            {t.kind === "has" ? (
              <>
                <p class="tally ui">
                  {cases_(t.n)}: {breakdown(list)}
                </p>
                <ul>
                  {list.slice(0, PANEL_LIMIT).map((c) => (
                    <li>
                      <a href={`/cases/${c.id}/`}>
                        <CasePhoto entry={c} widths={[72, 144]} sizes="72px" class="thumb" />
                        <span class="meta ui">
                          <StatusChip status={c.data.status} />
                          <span>
                            {c.data.town}, {c.data.incidentDate.getUTCFullYear()}
                          </span>
                        </span>
                        <span class="title">{c.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="all ui" href={`/states/${t.code.toLowerCase()}/`}>
                  {t.n > PANEL_LIMIT ? `All ${t.n} ${t.name} cases` : `${t.name} cases`}
                </a>
              </>
            ) : (
              <>
                <p class="tally ui">No stories yet</p>
                <p class="soon-note">
                  {t.name} is next on our list. If there's a case there that people should know about, tell us. We read
                  every suggestion.
                </p>
                <a class="all ui" href="/suggest/">
                  Suggest a {t.name} case
                </a>
              </>
            )}
          </section>
        );
      })
    }
  </div>
</div>

<script>
  for (const map of document.querySelectorAll<HTMLElement>("[data-case-map]")) {
    const tiles = [...map.querySelectorAll<HTMLAnchorElement>("a[data-state]")];
    const panels = [...map.querySelectorAll<HTMLElement>("[data-panel]")];

    for (const tile of tiles) {
      tile.setAttribute("role", "button");
      tile.setAttribute("aria-pressed", String(tile.hasAttribute("aria-current")));
      tile.removeAttribute("aria-current");
      tile.addEventListener("keydown", (e) => {
        if (e.key === " ") {
          e.preventDefault();
          tile.click();
        }
      });
      tile.addEventListener("click", (e) => {
        e.preventDefault();
        const code = tile.dataset.state!;
        for (const t of tiles) t.setAttribute("aria-pressed", String(t === tile));
        for (const p of panels) p.hidden = p.dataset.panel !== code;
        document.dispatchEvent(new CustomEvent("bct:map-select", { detail: { state: code } }));
      });
    }
  }
</script>

<style>
  .case-map {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .case-map {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    grid-template-rows: repeat(8, auto);
    gap: clamp(2px, 0.5vw, 5px);
    max-width: 40rem;
  }

  .tile {
    grid-column: var(--c);
    grid-row: var(--r);
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    min-width: 24px;
    border-radius: var(--radius-s);
    font-family: var(--font-ui);
    text-decoration: none;
    line-height: 1;
  }

  .abbr {
    font-size: clamp(0.6rem, 0.45rem + 0.6vw, 0.82rem);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .none {
    border: 1px solid var(--color-line);
    color: #6B625A;
  }

  .none .abbr {
    font-weight: 400;
  }

  .soon {
    border: 1px dashed var(--color-lamp);
    color: var(--color-lamp);
  }

  .s1 {
    background: #4A1512;
    color: var(--color-bone);
  }

  .s2 {
    background: #7A0D0A;
    color: var(--color-bone);
  }

  .s3 {
    background: var(--color-blood);
    color: #FFF4E8;
  }

  .n {
    position: absolute;
    right: 3px;
    bottom: 2px;
    font-size: 0.62rem;
    opacity: 0.85;
  }

  @media (max-width: 30rem) {
    .n {
      display: none;
    }
  }

  a.tile {
    transition:
      transform var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  a.tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-raised);
  }

  a.tile[aria-pressed="true"],
  a.tile[aria-current="true"] {
    outline: 2px solid var(--color-bone);
    outline-offset: 2px;
    z-index: 1;
  }

  a.tile:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    a.tile {
      transition: none;
    }

    a.tile:hover {
      transform: none;
    }
  }

  .panel {
    border-top: 3px solid var(--color-blood);
    padding-top: var(--space-s);
  }

  .panel h3 {
    margin: 0;
    font-size: var(--step-3);
    line-height: var(--leading-tight);
  }

  .tally {
    margin: var(--space-3xs) 0 var(--space-s);
    color: var(--color-ash);
    font-size: var(--step--1);
  }

  .panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel li a {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--space-s);
    row-gap: var(--space-3xs);
    align-items: start;
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-bone);
    text-decoration: none;
  }

  .panel li a:hover .title {
    text-decoration: underline;
  }

  .panel :global(.thumb) {
    grid-row: 1 / span 2;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-s);
  }

  .panel :global(.thumb .mark) {
    font-size: var(--step-1);
  }

  .panel :global(.thumb .place) {
    display: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-ash);
    font-size: var(--step--1);
  }

  .title {
    font-size: var(--step-0);
    line-height: 1.25;
  }

  .soon-note {
    max-width: 34ch;
    margin: 0;
  }

  .all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-2xs);
    color: var(--color-ember);
  }
</style>
