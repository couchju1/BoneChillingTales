---
import "../styles/forms.css";
import { site, isPlaceholder } from "../lib/config";

interface Props {
  heading: string;
  body: string;
  button?: string;
  /** Story id, sent to Kit when newsletter.caseField is set so a signup can be tagged with it. */
  caseId?: string;
}

const { heading, body, button = "Get the weekly email", caseId } = Astro.props;
const action = site.newsletter.formAction;
const ready = !isPlaceholder(action);
const caseField = site.newsletter.caseField;
const uid = `nl-${caseId ?? "site"}`;
---

<section class="newsletter" aria-labelledby={`${uid}-heading`}>
  <h2 id={`${uid}-heading`}>{heading}</h2>
  <p>{body}</p>
  <form method="post" action={ready ? action : undefined} novalidate data-newsletter-form>
    <fieldset disabled={!ready} data-fields>
      <div class="field">
        <label for={`${uid}-email`}>Email</label>
        <div class="row">
          <input
            id={`${uid}-email`}
            name="email_address"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
            aria-describedby={`${uid}-email-error`}
          />
          {caseId && caseField && <input type="hidden" name={`fields[${caseField}]`} value={caseId} />}
          <button type="submit" class="btn-primary">{button}</button>
        </div>
        <p id={`${uid}-email-error`} class="field-error" hidden></p>
      </div>
    </fieldset>
    <p class="form-message" role="status" data-message>{!ready && "Sign-up opens soon."}</p>
  </form>
</section>

<script>
  import { EMAIL, setBusy, setFieldError, clearFieldError } from "../lib/form-ui";

  const COPY = {
    invalid: "That email doesn't look right. Check it and try again.",
    success: "You're in. Check your inbox to confirm.",
    already: "You're already on the list.",
    error: "That didn't go through. Try again in a minute.",
  };

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]")) {
    if (!form.getAttribute("action")) continue;
    const input = form.querySelector<HTMLInputElement>("input[type=email]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const fields = form.querySelector<HTMLFieldSetElement>("[data-fields]")!;
    const message = form.querySelector<HTMLElement>("[data-message]")!;
    const say = (text: string, tone: "success" | "error" | "") => {
      message.textContent = text;
      message.dataset.tone = tone;
    };

    input.addEventListener("input", () => clearFieldError(input));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      say("", "");
      const email = input.value.trim();
      if (!EMAIL.test(email)) {
        setFieldError(input, COPY.invalid);
        input.focus();
        return;
      }

      document.dispatchEvent(new CustomEvent("bct:newsletter-submit"));
      setBusy(button, true);
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        const text = JSON.stringify(data).toLowerCase();
        if (res.ok && data.status === "success") {
          fields.hidden = true;
          say(COPY.success, "success");
          document.dispatchEvent(new CustomEvent("bct:newsletter-success"));
        } else if (text.includes("already")) {
          fields.hidden = true;
          say(COPY.already, "success");
        } else if (text.includes("email")) {
          setFieldError(input, COPY.invalid);
          input.focus();
        } else {
          say(COPY.error, "error");
        }
      } catch {
        // Couldn't read Kit's answer (offline, or the browser blocked it). If online, let the browser post the form itself.
        if (navigator.onLine) {
          form.submit();
          return;
        }
        say(COPY.error, "error");
      } finally {
        setBusy(button, false);
      }
    });
  }
</script>

<style>
  .newsletter {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-blood);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }

  h2 {
    font-size: var(--step-2);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .field {
    margin-bottom: 0;
  }

  .field label {
    color: var(--color-ash);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .row input {
    flex: 1 1 14rem;
    width: auto;
  }

  fieldset:disabled input,
  fieldset:disabled button {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .form-message:empty {
    display: none;
  }
</style>
