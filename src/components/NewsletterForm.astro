---
import "../styles/forms.css";
import { site, isPlaceholder } from "../lib/config";
import { STATE_NAMES } from "../lib/content";

interface Props {
  heading: string;
  body: string;
  button?: string;
  /** Story id. Sent with email sign-ups, and to Kit when newsletter.caseField is set. */
  caseId?: string;
  /** Makes field ids unique when the same story has more than one form (the popup). */
  idPrefix?: string;
  /** Drops the bordered box, for forms that sit inside the popup. */
  bare?: boolean;
}

const { heading, body, button = "Get the weekly email", caseId, idPrefix = "nl", bare = false } = Astro.props;
const { provider, formAction: action, caseField } = site.newsletter;
const byEmail = provider === "email";
// Email sign-ups go to the Suggest-a-case inbox, so they wait on that address too.
const ready = !isPlaceholder(action) && !(byEmail && isPlaceholder(site.forms.suggestTo));
const uid = `${idPrefix}-${caseId ?? "site"}`;
const states = Object.entries(STATE_NAMES).sort((a, b) => a[1].localeCompare(b[1]));
// Kit takes first_name and custom fields; email sign-ups use plain names.
const name = (field: string) => (byEmail || field === "email_address" || field === "first_name" ? field : `fields[${field}]`);
const textFields = [
  { key: "first_name", label: "First name", autocomplete: "given-name", max: 80 },
  { key: "last_name", label: "Last name", autocomplete: "family-name", max: 80 },
  { key: "email_address", label: "Email", autocomplete: "email", max: 254, type: "email" as const, wide: true },
  { key: "city", label: "City", autocomplete: "address-level2", max: 100 },
];
---

<section class:list={["newsletter", { bare }]} aria-labelledby={`${uid}-heading`}>
  <h2 id={`${uid}-heading`}>{heading}</h2>
  <p>{body}</p>
  <form method="post" action={ready ? action : undefined} novalidate data-newsletter-form data-provider={provider}>
    <fieldset disabled={!ready} data-fields>
      <div class="grid">
        {
          textFields.map((f) => (
            <div class:list={["field", { wide: f.wide }]}>
              <label for={`${uid}-${f.key}`}>{f.label}</label>
              <input
                id={`${uid}-${f.key}`}
                name={name(f.key)}
                type={f.type ?? "text"}
                autocomplete={f.autocomplete}
                required
                maxlength={f.max}
                aria-describedby={`${uid}-${f.key}-error`}
                data-label={f.label}
              />
              <p id={`${uid}-${f.key}-error`} class="field-error" hidden />
            </div>
          ))
        }
        <div class="field">
          <label for={`${uid}-state`}>State</label>
          <select
            id={`${uid}-state`}
            name={name("state")}
            autocomplete="address-level1"
            required
            aria-describedby={`${uid}-state-error`}
            data-label="State"
          >
            <option value="">Choose one</option>
            {states.map(([code, label]) => <option value={code}>{label}</option>)}
            <option value="Outside the US">Outside the US</option>
          </select>
          <p id={`${uid}-state-error`} class="field-error" hidden />
        </div>
      </div>
      {!byEmail && caseId && caseField && <input type="hidden" name={`fields[${caseField}]`} value={caseId} />}
      <button type="submit" class="btn-primary">{button}</button>
    </fieldset>
    {
      byEmail && (
        <>
          <div class="hp" aria-hidden="true">
            <label for={`${uid}-${site.forms.honeypotField}`}>Leave this empty</label>
            <input id={`${uid}-${site.forms.honeypotField}`} name={site.forms.honeypotField} type="text" tabindex="-1" autocomplete="off" />
          </div>
          {caseId && <input type="hidden" name="story" value={caseId} />}
          <input type="hidden" name="started" value="" data-started />
        </>
      )
    }
    <p class="form-message" role="status" data-message>{!ready && "Sign-up opens soon."}</p>
  </form>
</section>

<script>
  import { EMAIL, setBusy, setFieldError, clearFieldError } from "../lib/form-ui";

  const COPY = {
    invalid: "That email doesn't look right. Check it and try again.",
    missing: (label: string) => `Enter your ${label.toLowerCase()}.`,
    pickState: "Choose your state.",
    success: "You're in. Check your inbox to confirm.",
    joined: "You're on the list. The next weekly email will come to your inbox.",
    already: "You're already on the list.",
    error: "That didn't go through. Try again in a minute.",
  };

  type Field = HTMLInputElement | HTMLSelectElement;

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]")) {
    if (!form.getAttribute("action")) continue;
    const required = [...form.querySelectorAll<Field>("[data-label]")];
    const email = form.querySelector<HTMLInputElement>("input[type=email]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const fields = form.querySelector<HTMLFieldSetElement>("[data-fields]")!;
    const message = form.querySelector<HTMLElement>("[data-message]")!;
    const byEmail = form.dataset.provider === "email";
    const started = form.querySelector<HTMLInputElement>("[data-started]");
    if (started) started.value = String(Date.now());
    const say = (text: string, tone: "success" | "error" | "") => {
      message.textContent = text;
      message.dataset.tone = tone;
    };

    for (const field of required) {
      field.addEventListener(field instanceof HTMLSelectElement ? "change" : "input", () =>
        clearFieldError(field),
      );
    }

    /** Marks every empty or bad field and returns the first one, or null when all are fine. */
    const firstProblem = (): Field | null => {
      let first: Field | null = null;
      for (const field of required) {
        const value = field.value.trim();
        let problem = "";
        if (!value) problem = field instanceof HTMLSelectElement ? COPY.pickState : COPY.missing(field.dataset.label!);
        else if (field === email && !EMAIL.test(value)) problem = COPY.invalid;
        if (problem) {
          setFieldError(field, problem);
          first ??= field;
        } else {
          clearFieldError(field);
        }
      }
      return first;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      say("", "");
      const problem = firstProblem();
      if (problem) {
        problem.focus();
        return;
      }

      document.dispatchEvent(new CustomEvent("bct:newsletter-submit"));
      setBusy(button, true);
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        const text = JSON.stringify(data).toLowerCase();
        if (res.ok && data.status === "success") {
          fields.hidden = true;
          say(byEmail ? COPY.joined : COPY.success, "success");
          document.dispatchEvent(new CustomEvent("bct:newsletter-success"));
        } else if (text.includes("already")) {
          fields.hidden = true;
          say(COPY.already, "success");
          document.dispatchEvent(new CustomEvent("bct:newsletter-success"));
        } else if (text.includes("email")) {
          setFieldError(email, COPY.invalid);
          email.focus();
        } else {
          say(typeof data.message === "string" && data.message ? data.message : COPY.error, "error");
        }
      } catch {
        // Couldn't read the answer (offline, or the browser blocked it). If online, let the browser post the form itself.
        if (navigator.onLine) {
          form.submit();
          return;
        }
        say(COPY.error, "error");
      } finally {
        setBusy(button, false);
      }
    });
  }
</script>

<style>
  .newsletter {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-blood);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }

  .newsletter.bare {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
  }

  h2 {
    font-size: var(--step-2);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-s);
    max-width: 40rem;
  }

  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .grid .wide {
    grid-column: 1 / -1;
  }

  .field {
    margin-bottom: var(--space-s);
  }

  .field label {
    color: var(--color-ash);
  }

  .field select {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--color-input-border);
    border-radius: var(--radius-m);
    background: var(--color-night);
    color: var(--color-bone);
    font: inherit;
    font-family: var(--font-ui);
  }

  .field select[aria-invalid="true"] {
    border-color: var(--color-ember);
  }

  button {
    margin-top: var(--space-2xs);
  }

  fieldset:disabled input,
  fieldset:disabled select,
  fieldset:disabled button {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .form-message:empty {
    display: none;
  }
</style>
