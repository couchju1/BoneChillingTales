---
import { isoDate } from "../lib/dates";
import { daysSinceText } from "../lib/days-since";

interface Props {
  /** The day the count starts from. */
  since: Date;
  /** "Missing" or "Unsolved". */
  label: string;
}

const { since, label } = Astro.props;
const day = isoDate(since);
---

<!-- Holds its space invisibly until the browser fills in today's count (see src/lib/days-since.ts). -->
<span class="days-since ui pending" data-days-since={day} data-label={label} aria-hidden="true">{daysSinceText(day, label)}</span>

<script>
  import { fillDaysSince } from "../lib/days-since";
  fillDaysSince();
</script>

<style>
  .days-since {
    font-weight: 600;
    color: var(--color-bone);
  }
</style>
