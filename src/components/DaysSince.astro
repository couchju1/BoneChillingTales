---
import { isoDate } from "../lib/dates";

interface Props {
  /** The day the count starts from. */
  since: Date;
  /** "Missing" or "Unsolved". */
  label: string;
}

const { since, label } = Astro.props;
---

<!-- Hidden until the browser fills in today's count. Without JS the status line still shows the date. -->
<span class="days-since ui" data-days-since={isoDate(since)} data-label={label} hidden></span>

<script>
  import { fillDaysSince } from "../lib/days-since";
  fillDaysSince();
</script>

<style>
  .days-since {
    font-weight: 600;
    color: var(--color-bone);
  }
</style>
