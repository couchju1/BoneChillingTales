---
import { site, type CaseStatus } from "../lib/config";

interface Props {
  status: CaseStatus;
}

const { status } = Astro.props;
---

<span class={`chip ui chip-${status}`}>{site.statuses[status].label}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: 0.15em 0.6em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }
  .chip::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: currentColor;
  }
  .chip-unsolved { color: var(--color-ember); }
  .chip-missing { color: var(--color-lamp); }
  .chip-solved { color: var(--color-solved); }
  .chip-in-court { color: var(--color-bone); }
  .chip-in-court::before { display: none; }
</style>
