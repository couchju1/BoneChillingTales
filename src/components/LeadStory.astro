---
import StatusChip from "./StatusChip.astro";
import CasePhoto from "./CasePhoto.astro";
import { stripCitations } from "../lib/sources";
import type { Case } from "../lib/content";

interface Props {
  entry: Case;
}

const { entry } = Astro.props;
const { data } = entry;
const href = `/cases/${entry.id}/`;
---

<article class="lead" aria-labelledby="lead-title">
  <div class="text">
    <p class="label ui">
      <span>Newest story</span>
      <StatusChip status={data.status} />
      <span>{data.town}, {data.state}</span>
    </p>
    <h2 id="lead-title"><a href={href}>{data.title}</a></h2>
    {data.summary && <p class="summary">{stripCitations(data.summary)}</p>}
    <a class="read ui" href={href} aria-describedby="lead-title">Read the story</a>
  </div>
  <a class:list={["photo", { "no-photo": !data.image }]} href={href} tabindex="-1" aria-hidden={data.image ? undefined : "true"}>
    <CasePhoto entry={entry} widths={[400, 800]} sizes="(min-width: 48rem) 24rem, 100vw" class="lead-photo" loading="eager" />
  </a>
</article>

<style>
  .lead {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-l) var(--space-xl);
    border-bottom: 1px solid var(--color-line);
  }

  .label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin-bottom: var(--space-s);
    color: var(--color-ash);
  }

  .label > span:first-child {
    color: var(--color-ember);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    max-width: 18ch;
    margin-bottom: var(--space-m);
    font-size: var(--step-5);
  }

  h2 a {
    color: var(--color-bone);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-ember);
  }

  .summary {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .read {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-blood);
    color: var(--color-bone);
    font-weight: 600;
    text-decoration: none;
  }

  .read:hover {
    background: var(--color-blood-hover);
  }

  .photo {
    display: block;
    max-width: 28rem;
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-raised);
    text-decoration: none;
  }

  .photo :global(.lead-photo) {
    aspect-ratio: 4 / 3;
    height: auto;
    transition: transform var(--motion-base) var(--ease-out);
  }

  .photo:hover :global(.lead-photo) {
    transform: scale(1.02);
  }

  /* Photo first on phones, so the page opens on a face. The no-photo card waits for wider screens. */
  .photo {
    order: -1;
  }

  .no-photo {
    display: none;
  }

  @media (min-width: 48rem) {
    .lead {
      grid-template-columns: 1fr 24rem;
      align-items: start;
      gap: var(--space-xl);
    }

    .photo {
      order: 0;
    }

    .no-photo {
      display: block;
    }

    .photo :global(.lead-photo) {
      aspect-ratio: 4 / 5;
    }
  }
</style>
