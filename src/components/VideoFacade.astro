---
interface Props {
  youtubeId: string;
  title: string;
}

const { youtubeId, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
---

<!-- A link to YouTube without JS. With JS, a tap swaps in the privacy-enhanced player, captions on. -->
<a
  class="video-facade"
  href={`https://www.youtube.com/watch?v=${youtubeId}`}
  data-video-facade={youtubeId}
  data-title={title}
  aria-label={`Play video: ${title}`}
>
  <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async" />
  <span class="play" aria-hidden="true">
    <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.6 1.4a8.5 8.5 0 0 0-6 6C0 13 0 24 0 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.6-1.4a8.5 8.5 0 0 0 6-6C68 35 68 24 68 24s0-11-1.5-16.3Z" fill="#AD0404"></path><path d="m27 34 18-10-18-10z" fill="#E8DACB"></path></svg>
  </span>
</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-video-facade]")) {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const iframe = document.createElement("iframe");
      const params = new URLSearchParams({ autoplay: "1", cc_load_policy: "1", rel: "0" });
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.videoFacade}?${params}`;
      iframe.title = link.dataset.title ?? "Video";
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "video-frame";
      link.replaceWith(iframe);
      iframe.focus();
      document.dispatchEvent(new CustomEvent("bct:video-play", { detail: { id: link.dataset.videoFacade } }));
    });
  }
</script>

<style>
  .video-facade {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--motion-base) var(--ease-out);
  }

  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .video-facade:hover img,
  .video-facade:focus-visible img {
    opacity: 0.8;
  }

  :global(.video-frame) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-m);
  }
</style>
