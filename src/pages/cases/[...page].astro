---
import type { GetStaticPaths } from "astro";
import Hub from "../../layouts/Hub.astro";
import { hubRows, requireHubCopy, PAGE_SIZE, EMPTY_HUB } from "../../lib/hubs";

export const getStaticPaths = (async ({ paginate }) => {
  const rows = await hubRows();
  return paginate(rows, { pageSize: PAGE_SIZE, props: { allRows: rows } });
}) satisfies GetStaticPaths;

const { page, allRows } = Astro.props;
const copy = await requireHubCopy("cases");
---

<Hub
  seoTitle={copy.seoTitle ?? copy.title}
  description={copy.description}
  heading={copy.title}
  breadcrumbs={[{ name: "Cases" }]}
  page={page}
  base="/cases/"
  allRows={allRows}
  showStatusFilter
  emptyFilterText={copy.emptyFilter ?? "No cases match that yet."}
  emptyHubText={EMPTY_HUB}
>
  <copy.Content slot="intro" />
</Hub>
